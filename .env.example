# Copy this file to .env and add your key.
# No VITE_ prefix on purpose: the key stays on the dev server and is never bundled into browser code.
ANTHROPIC_API_KEY=your-key-here

# PostgreSQL connection string for the journal database (the database must already exist).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/journal

# Port for the Express API server.
PORT=3001
